# ============================================================
# Fleet Management Dashboard - Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# Never commit the real .env file.

# ---- Backend ------------------------------------------------
PORT=3000

# Admin token for protecting POST /config and GET /config endpoints.
# Set a strong random string in production.
ADMIN_TOKEN=changeme-admin-token

# Time in ms before a robot that stops sending updates is marked stale/offline.
ROBOT_STALE_TIMEOUT_MS=10000

# CORS allowed origins. Comma-separated. Use * for development only.
CORS_ORIGIN=http://localhost:5173

# ---- Simulator ----------------------------------------------
# URL of the backend ingestion endpoint.
BACKEND_URL=http://localhost:3000

# Initial fleet size. Overrides robots.json if larger than 8.
FLEET_SIZE=8

# How often each robot sends an update (milliseconds).
UPDATE_INTERVAL_MS=1000

# Target payload size in bytes (adds padding to simulate larger payloads).
PAYLOAD_SIZE=512
