{
  "name": "fleet-management-dashboard",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "simulator",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,simulator,frontend -c cyan,yellow,magenta \"npm run dev --workspace=backend\" \"npm run dev --workspace=simulator\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:simulator": "npm run dev --workspace=simulator",
    "dev:frontend": "npm run dev --workspace=frontend",
    "test": "npm run test --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
